# The FastAPI backend. Server-side only — never exposed to the browser.
BLOGS_API_URL=http://localhost:8000

# Public origin of THIS Next.js app. Must match BLOGS_OAUTH_REDIRECT_BASE_URL
# in the backend's .env, or the OAuth callback lands on the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header and footer.
NEXT_PUBLIC_SITE_NAME=Canerly

# Where article data comes from. "api" reads from FastAPI and is the default;
# "fixtures" renders the whole site from typed sample data with no backend
# running. Server-side only, so one build can serve either.
BLOGS_DATA_SOURCE=api

# Search has no backend endpoint yet. Unset (or "none") reports search as
# unavailable, which is the truth. "mock" filters the cached feed client-side.
# "http" targets GET /api/v1/search once that endpoint exists.
NEXT_PUBLIC_SEARCH_ADAPTER=none

# OAuth buttons to offer. Empty means none — list a provider only once the
# backend has credentials for it, or sign-in 404s after the user commits to it.
# NEXT_PUBLIC_OAUTH_PROVIDERS=google,github

# Must match BLOGS_OTP_DEV_BYPASS_CODE in the backend's .env. Shown on the code
# screen so a reviewer knows what to type. Development only — the backend
# refuses to start in production with it set.
BLOGS_OTP_DEV_BYPASS_CODE=000000

# Must match BLOGS_ADMIN_PATH_PREFIX in the backend's .env. The admin console
# is served at this path and nowhere else.
#
# Server-side only, and deliberately NOT a NEXT_PUBLIC_ variable: those are
# inlined into the browser bundle, which would publish the one thing the secret
# prefix exists to withhold.
BLOGS_ADMIN_PATH_PREFIX=/replace-with-the-backend-value
